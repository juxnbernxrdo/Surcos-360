// Prisma Schema for Surcos 360 - Enterprise Architecture
// Source of truth: surcos-360-prd-v1.md

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// 1. IDENTITY & USERS DOMAIN (§3 PRD v1.0)
// ------------------------------------------------------

enum UserType {
  STUDENT
  TEACHER
  AUTHORITY
  REPRESENTATIVE
}

enum OrganizationRole {
  ADMIN
  USER
}

enum TokenType {
  STUDENT
  TEACHER
  AUTHORITY
  REPRESENTATIVE
  PYME_MEMBER
}

enum TokenStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  REVOKED
}

model InstitutionalPerson {
  id                String            @id @default(uuid())
  institutionId     String            @default("default-institution")
  userType          UserType          @default(STUDENT)
  firstName         String
  lastName          String
  email             String            @unique
  institutionalCode String            @unique
  userId            String?           @unique // Vinculación a Supabase Auth / User
  status            InstitutionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones de Perfil Especializado
  studentProfile        StudentProfile?
  teacherProfile        TeacherProfile?
  authorityProfile      AuthorityProfile?
  representativeProfile RepresentativeProfile?

  // Relaciones Comerciales & Operativas
  customers               Customer[]
  suppliers               Supplier[]
  memberships             Membership[]             @relation("MemberPerson")
  invitedMembers          Membership[]             @relation("InvitedMembers")
  studentAccount          StudentAccount?
  issuedTokens            RegistrationToken[]      @relation("CreatedTokens")
  organizationInvitations OrganizationInvitation[] @relation("CreatedInvitations")
  gymVisits               GymVisit[]               @relation("StudentVisits")

  @@index([institutionId])
  @@index([email])
  @@index([institutionalCode])
}

model StudentProfile {
  id                    String              @id @default(uuid())
  institutionalPersonId String              @unique
  institutionalPerson   InstitutionalPerson @relation(fields: [institutionalPersonId], references: [id], onDelete: Cascade)

  course           String
  academicYear     String?             @default("2026-2027")
  tutor            String?
  representativeId String?
  representative   RepresentativeProfile? @relation(fields: [representativeId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([course])
  @@index([representativeId])
}

model TeacherProfile {
  id                    String              @id @default(uuid())
  institutionalPersonId String              @unique
  institutionalPerson   InstitutionalPerson @relation(fields: [institutionalPersonId], references: [id], onDelete: Cascade)

  department String?
  title      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuthorityProfile {
  id                    String              @id @default(uuid())
  institutionalPersonId String              @unique
  institutionalPerson   InstitutionalPerson @relation(fields: [institutionalPersonId], references: [id], onDelete: Cascade)

  charge       String?
  jurisdiction String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RepresentativeProfile {
  id                    String              @id @default(uuid())
  institutionalPersonId String              @unique
  institutionalPerson   InstitutionalPerson @relation(fields: [institutionalPersonId], references: [id], onDelete: Cascade)

  phoneNumber          String?
  identificationNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students StudentProfile[]
}

model Organization {
  id          String             @id @default(uuid())
  name        String
  code        String             @unique // e.g. "SAVING", "AGRORED", "FIT", "SURCASINO"
  description String?
  isPyme      Boolean            @default(true)
  status      OrganizationStatus @default(ACTIVE)
  settings    Json               @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  invitations     OrganizationInvitation[]
  ledgerAccounts  LedgerAccount[]
  transactions    Transaction[]
  products        Product[]
  inventories     Inventory[]
  assets          Asset[]
  liabilities     Liability[]
  expenses        Expense[]
  suppliers       Supplier[]
  customers       Customer[]
  purchases       Purchase[]
  sales           Sale[]
  gymVisits       GymVisit[]
  rentals         Rental[]
  auditLogs       AuditLog[]

  @@index([code])
  @@index([status])
}

model Membership {
  id                    String              @id @default(uuid())
  institutionalPersonId String
  institutionalPerson   InstitutionalPerson @relation("MemberPerson", fields: [institutionalPersonId], references: [id], onDelete: Cascade)
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                  OrganizationRole    @default(USER)
  permissions           String[]            @default([]) // e.g. ["inventory.read", "sales.create"]
  status                MembershipStatus    @default(ACTIVE)
  joinedAt              DateTime?           @default(now())
  leftAt                DateTime?
  invitedById           String?
  invitedBy             InstitutionalPerson? @relation("InvitedMembers", fields: [invitedById], references: [id], onDelete: SetNull)
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionalPersonId, organizationId])
  @@index([organizationId])
  @@index([institutionalPersonId])
  @@index([status])
}

model OrganizationInvitation {
  id             String              @id @default(uuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrganizationRole    @default(USER)
  permissions    String[]            @default([])
  tokenHash      String              @unique
  status         TokenStatus         @default(ACTIVE)
  maxUses        Int                 @default(1)
  usesCount      Int                 @default(0)
  expiresAt      DateTime
  invitedBy      String
  inviter        InstitutionalPerson @relation("CreatedInvitations", fields: [invitedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
  @@index([tokenHash])
}

model RegistrationToken {
  id          String      @id @default(uuid())
  type        TokenType
  tokenHash   String      @unique
  status      TokenStatus @default(ACTIVE)
  maxUses     Int         @default(1)
  usesCount   Int         @default(0)
  expiresAt   DateTime
  createdBy   String
  creator     InstitutionalPerson @relation("CreatedTokens", fields: [createdBy], references: [id])
  metadata    Json        @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tokenHash])
}

// ------------------------------------------------------
// 2. FINANCIAL & DOUBLE-ENTRY LEDGER DOMAIN (§7 PRD v1.0)
// ------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  STUDENT_WALLET
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum TransactionType {
  INITIAL_BALANCE
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  SALE
  REFUND
  TRANSFER
  ADJUSTMENT
  EXPENSE
  RENTAL_FEE
  VISIT_FEE
  REVERSAL
  LIABILITY_PAYMENT
  ASSET_PURCHASE
  ASSET_SALE
  COGS
}

model StudentAccount {
  id                    String              @id @default(uuid())
  institutionalPersonId String              @unique
  institutionalPerson   InstitutionalPerson @relation(fields: [institutionalPersonId], references: [id], onDelete: Cascade)
  accountNumber         String              @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([accountNumber])
}

model LedgerAccount {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           AccountType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]

  @@unique([organizationId, code])
}

model Transaction {
  id                String          @id @default(uuid())
  transactionNumber String?         @unique
  type              TransactionType
  description       String
  referenceType     String?         // e.g. "SALE", "PURCHASE", "VISIT", "RENTAL", "EXPENSE", "STUDENT_ACCOUNT", "LIABILITY", "ASSET"
  referenceId       String?
  actorId           String          // InstitutionalPerson ID
  idempotencyKey    String?         @unique
  organizationId    String?
  organization      Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reversalOfId      String?
  currency          String          @default("USD") // Moneda de la transacción (§23 PRD v1.0)
  metadata          Json?           // Contexto extensible: correlación, origen, estado de negocio

  createdAt DateTime @default(now())

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
  @@index([organizationId])
  @@index([reversalOfId])
  @@index([type])
  @@index([actorId])
  @@index([createdAt])
}

model LedgerEntry {
  id               String         @id @default(uuid())
  transactionId    String
  transaction      Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  studentAccountId String?
  studentAccount   StudentAccount? @relation(fields: [studentAccountId], references: [id])
  ledgerAccountId  String?
  ledgerAccount    LedgerAccount?  @relation(fields: [ledgerAccountId], references: [id])

  direction        EntryDirection
  amount           Decimal        @db.Decimal(12, 2) // NUMERIC(12,2) - Nunca FLOAT!

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([studentAccountId])
  @@index([ledgerAccountId])
  @@index([studentAccountId, createdAt])
  @@index([ledgerAccountId, createdAt])
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String
  actorId      String
  endpoint     String
  responseHash String
  responseData Json
  
  createdAt    DateTime @default(now())

  @@unique([key, actorId, endpoint])
}

// ------------------------------------------------------
// 3. COMMERCIAL, INVENTORY & PYMES DOMAIN (§8 & §9 PRD v1.0)
// ------------------------------------------------------

enum ProductType {
  PRODUCT
  RAW_MATERIAL
  SUPPLY
  CONSUMABLE
  SERVICE
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum InventoryItemStatus {
  AVAILABLE
  RESERVED
  DAMAGED
  EXPIRED
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  LOSS
}

enum PurchaseStatus {
  RECEIVED
  PENDING
  PAID
  CANCELLED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  STUDENT_ACCOUNT
  CASH
  TRANSFER
  CARD
  OTHER
}

enum AssetType {
  EQUIPMENT
  FURNITURE
  MACHINERY
  VEHICLE
  COMPUTER
  GAME
  SPORTS_MATERIAL
  OTHER
}

enum AssetStatus {
  ACTIVE
  MAINTENANCE
  DAMAGED
  SOLD
  DISPOSED
}

enum LiabilityType {
  ACCOUNTS_PAYABLE
  LOAN
  CREDIT
  OBLIGATION
  OTHER
}

enum LiabilityStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum VisitType {
  FREE
  PAID
}

enum VisitStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RentalStatus {
  ACTIVE
  RETURNED
  OVERDUE
  CANCELLED
}

model Supplier {
  id                    String               @id @default(uuid())
  organizationId        String
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institutionalPersonId String?              // Desacoplado: opcional si es usuario institucional
  institutionalPerson   InstitutionalPerson? @relation(fields: [institutionalPersonId], references: [id], onDelete: SetNull)

  name                  String
  companyName           String?
  taxId                 String?              // Cédula o RUC
  email                 String?
  phone                 String?
  address               String?
  paymentTerms          String?
  isActive              Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases   Purchase[]
  liabilities Liability[]

  @@index([organizationId])
  @@index([institutionalPersonId])
  @@index([taxId])
}

model Customer {
  id                    String               @id @default(uuid())
  organizationId        String?              // Desacoplado: puede ser global o local a PYME
  organization          Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  institutionalPersonId String?              // Desacoplado: opcional si es estudiante/maestro/autoridad
  institutionalPerson   InstitutionalPerson? @relation(fields: [institutionalPersonId], references: [id], onDelete: Cascade)

  name                  String?
  email                 String?
  phone                 String?
  taxId                 String?              // Cédula / RUC
  customerType          String               @default("STUDENT") // STUDENT, TEACHER, REPRESENTATIVE, AUTHORITY, EXTERNAL, OTHER
  isActive              Boolean              @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  sales     Sale[]
  gymVisits GymVisit[]
  rentals   Rental[]

  @@index([organizationId])
  @@index([institutionalPersonId])
  @@index([taxId])
  @@index([email])
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sku            String
  name           String
  description    String?
  category       String
  unit           String        // e.g. "UNIT", "KG", "LITER", "PACKAGE", "HOUR", "DOZEN", "POUND", "BUNCH"
  type           ProductType   @default(PRODUCT)
  status         ProductStatus @default(ACTIVE)

  salePrice      Decimal       @db.Decimal(12, 2)
  averageCost    Decimal       @default(0.00) @db.Decimal(12, 2) // Weighted Average Cost (WAC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]
  rentals            Rental[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([category])
  @@index([status])
}

model Inventory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  locationName   String       @default("Bodega Principal")
  quantity       Decimal      @default(0) @db.Decimal(12, 2)
  minStock       Decimal      @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, locationName])
  @@index([organizationId])
  @@index([productId])
}

model InventoryMovement {
  id            String       @id @default(uuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          MovementType
  quantity      Decimal      @db.Decimal(12, 2)
  unitCost      Decimal      @db.Decimal(12, 2)
  previousStock Decimal      @db.Decimal(12, 2)
  newStock      Decimal      @db.Decimal(12, 2)
  referenceId   String?
  actorId       String

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model Asset {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code               String       // e.g. "AST-FIT-001", "AST-CASINO-014"
  serialNumber       String?
  name               String
  description        String?
  type               AssetType    @default(EQUIPMENT)
  acquisitionDate    DateTime     @default(now())
  acquisitionCost    Decimal      @db.Decimal(12, 2)
  currentValuation   Decimal      @db.Decimal(12, 2)
  status             AssetStatus  @default(ACTIVE)
  physicalLocation   String?
  responsibleId      String?      // InstitutionalPerson ID
  isAvailableForSale Boolean      @default(false)
  salePrice          Decimal?     @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rentals   Rental[]
  saleItems SaleItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
}

model Liability {
  id                 String          @id @default(uuid())
  organizationId     String
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code               String          // e.g. "LIA-AGR-001"
  type               LiabilityType   @default(ACCOUNTS_PAYABLE)
  description        String
  supplierId         String?
  supplier           Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  initialAmount      Decimal         @db.Decimal(12, 2)
  outstandingBalance Decimal         @db.Decimal(12, 2)
  dueDate            DateTime?
  status             LiabilityStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([status])
}

model Expense {
  id              String        @id @default(uuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  category        String        // e.g. "UTILITIES", "MAINTENANCE", "SUPPLIES", "TRANSPORT", "MARKETING", "OTHER"
  description     String
  amount          Decimal       @db.Decimal(12, 2)
  actorId         String        // InstitutionalPerson ID
  paymentMethod   PaymentMethod @default(CASH)
  referenceNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([category])
  @@index([createdAt])
}

model Purchase {
  id             String         @id @default(uuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id])
  actorId        String         // InstitutionalPerson ID

  totalAmount    Decimal        @db.Decimal(12, 2) // Subtotal - Descuentos (SIN IMPUESTOS §8.2)
  invoiceNumber  String?
  status         PurchaseStatus @default(RECEIVED)
  paymentTerms   String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  items PurchaseItem[]

  @@index([organizationId])
  @@index([supplierId])
  @@index([createdAt])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  quantity   Decimal  @db.Decimal(12, 2)
  unitCost   Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
}

model Sale {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  actorId        String        // InstitutionalPerson ID (Operador POS)

  totalAmount    Decimal       @db.Decimal(12, 2) // Subtotal - Descuentos (SIN IMPUESTOS §8.2)
  totalCost      Decimal       @db.Decimal(12, 2) // COGS total
  grossProfit    Decimal       @db.Decimal(12, 2) // totalAmount - totalCost
  paymentMethod  PaymentMethod @default(STUDENT_ACCOUNT)
  status         SaleStatus    @default(COMPLETED)
  invoiceNumber  String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  items SaleItem[]

  @@index([organizationId])
  @@index([customerId])
  @@index([createdAt])
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  assetId   String?
  asset     Asset?   @relation(fields: [assetId], references: [id])

  quantity  Decimal  @db.Decimal(12, 2)
  unitPrice Decimal  @db.Decimal(12, 2)
  unitCost  Decimal  @db.Decimal(12, 2)
  subtotal  Decimal  @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
  @@index([assetId])
}

model GymVisit {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  studentId      String?
  student        InstitutionalPerson? @relation("StudentVisits", fields: [studentId], references: [id], onDelete: SetNull)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  
  visitType      VisitType    @default(FREE)
  amount         Decimal      @default(0.00) @db.Decimal(12, 2)
  checkIn        DateTime     @default(now())
  checkOut       DateTime?
  registeredBy   String       // InstitutionalPerson ID
  status         VisitStatus  @default(COMPLETED)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([studentId])
  @@index([visitType])
}

model Rental {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assetId        String?
  asset          Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  productId      String?
  product        Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  
  itemName       String
  startTime      DateTime     @default(now())
  endTime        DateTime?
  durationHours  Decimal      @default(1.0) @db.Decimal(12, 2)
  hourlyRate     Decimal      @default(0.00) @db.Decimal(12, 2)
  totalAmount    Decimal      @default(0.00) @db.Decimal(12, 2)
  status         RentalStatus @default(ACTIVE)
  registeredBy   String       // InstitutionalPerson ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([status])
}

// ------------------------------------------------------
// 4. AUDIT DOMAIN (§13 PRD v1.0)
// ------------------------------------------------------

model AuditLog {
  id             String        @id @default(uuid())
  actorId        String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  action         String
  entity         String
  entityId       String
  previousState  Json?
  newState       Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([organizationId])
  @@index([entity, entityId])
}
