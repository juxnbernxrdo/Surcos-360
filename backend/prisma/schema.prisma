// Prisma Schema for Surcos 360 - V0 Walking Skeleton
// Source of truth: surcos-360-prd-v4.md & .specify/specs/v0-walking-skeleton/plan.md

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// 1. IDENTITY & USERS DOMAIN
// ------------------------------------------------------

enum UserType {
  STUDENT
  TEACHER
  REPRESENTATIVE
  AUTHORITY
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  EMPLOYEE
  VIEWER
}

enum TokenType {
  STUDENT
  TEACHER
  AUTHORITY
  REPRESENTATIVE
  PYME_MEMBER
}

enum TokenStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model InstitutionalPerson {
  id                String            @id @default(uuid())
  institutionId     String            @default("default-institution") // Prepara multi-tenancy (§15 PRD v4)
  firstName         String
  lastName          String
  email             String            @unique
  institutionalCode String            @unique
  userId            String?           @unique // Vinculación opcional a Supabase Auth User ID
  status            InstitutionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones
  studentRecord   StudentRecord?
  customer        Customer?
  memberships     Membership[]
  studentAccount  StudentAccount?
  issuedTokens    RegistrationToken[] @relation("CreatedTokens")

  @@index([institutionId])
  @@index([email])
  @@index([institutionalCode])
}

model StudentRecord {
  id                    String              @id @default(uuid())
  institutionalPersonId String              @unique
  institutionalPerson   InstitutionalPerson @relation(fields: [institutionalPersonId], references: [id], onDelete: Cascade)

  course String
  tutor  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique // e.g. "AGRORED", "SAVING"
  description String?
  isPyme      Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     Membership[]
  ledgerAccounts  LedgerAccount[]
  products        Product[]
  inventories     Inventory[]
  suppliers       Supplier[]
  purchases       Purchase[]
  sales           Sale[]
  auditLogs       AuditLog[]

  @@index([code])
}

model Membership {
  id                    String              @id @default(uuid())
  institutionalPersonId String
  institutionalPerson   InstitutionalPerson @relation(fields: [institutionalPersonId], references: [id], onDelete: Cascade)
  organizationId        String
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role                  OrganizationRole    @default(EMPLOYEE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([institutionalPersonId, organizationId])
}

model RegistrationToken {
  id          String      @id @default(uuid())
  type        TokenType
  tokenHash   String      @unique
  status      TokenStatus @default(ACTIVE)
  maxUses     Int         @default(1)
  usesCount   Int         @default(0)
  expiresAt   DateTime
  createdBy   String
  creator     InstitutionalPerson @relation("CreatedTokens", fields: [createdBy], references: [id])
  metadata    Json        @default("{}")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tokenHash])
}

// ------------------------------------------------------
// 2. FINANCIAL & DOUBLE-ENTRY LEDGER DOMAIN
// ------------------------------------------------------

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
  STUDENT_WALLET
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum TransactionType {
  INITIAL_BALANCE
  DEPOSIT
  WITHDRAWAL
  PURCHASE
  REFUND
  TRANSFER
  ADJUSTMENT
}

model StudentAccount {
  id                    String              @id @default(uuid())
  institutionalPersonId String              @unique
  institutionalPerson   InstitutionalPerson @relation(fields: [institutionalPersonId], references: [id], onDelete: Cascade)
  accountNumber         String              @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]

  @@index([accountNumber])
}

model LedgerAccount {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String
  name           String
  type           AccountType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgerEntries LedgerEntry[]

  @@unique([organizationId, code])
}

model Transaction {
  id            String          @id @default(uuid())
  type          TransactionType
  description   String
  referenceType String?         // e.g. "SALE", "PURCHASE"
  referenceId   String?         // e.g. saleId
  actorId       String          // InstitutionalPerson ID que ejecutó

  createdAt DateTime @default(now())

  entries LedgerEntry[]

  @@index([referenceType, referenceId])
}

model LedgerEntry {
  id               String         @id @default(uuid())
  transactionId    String
  transaction      Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  
  // Una entrada afecta a un StudentAccount O a una LedgerAccount de PYME
  studentAccountId String?
  studentAccount   StudentAccount? @relation(fields: [studentAccountId], references: [id])
  ledgerAccountId  String?
  ledgerAccount    LedgerAccount?  @relation(fields: [ledgerAccountId], references: [id])

  direction        EntryDirection
  amount           Decimal        @db.Decimal(12, 2) // NUMERIC(12,2) - Nunca FLOAT!

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([studentAccountId])
  @@index([ledgerAccountId])
}

model IdempotencyKey {
  id           String   @id @default(uuid())
  key          String
  actorId      String
  endpoint     String
  responseHash String
  responseData Json
  
  createdAt    DateTime @default(now())

  @@unique([key, actorId, endpoint])
}

// ------------------------------------------------------
// 3. COMMERCIAL, INVENTORY & AGRORED DOMAIN
// ------------------------------------------------------

enum ProductType {
  PRODUCT
  RAW_MATERIAL
  SUPPLY
  CONSUMABLE
  OTHER
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum InventoryItemStatus {
  AVAILABLE
  RESERVED
  DAMAGED
  EXPIRED
}

enum MovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  LOSS
}

model Supplier {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name           String
  companyName    String?
  taxId          String?
  email          String?
  phone          String?
  address        String?
  isActive       Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@index([organizationId])
}

model Product {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sku            String
  name           String
  description    String?
  category       String
  unit           String        // e.g. "UNIT", "KG", "LITER"
  type           ProductType   @default(PRODUCT)
  status         ProductStatus @default(ACTIVE)

  salePrice      Decimal       @db.Decimal(12, 2)
  averageCost    Decimal       @default(0.00) @db.Decimal(12, 2) // Weighted Average Cost (WAC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventories        Inventory[]
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]
  saleItems          SaleItem[]

  @@unique([organizationId, sku])
}

model Inventory {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  locationName   String       @default("Bodega Principal")
  quantity       Decimal      @default(0) @db.Decimal(12, 2)
  minStock       Decimal      @default(0) @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, locationName])
}

model InventoryMovement {
  id            String       @id @default(uuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          MovementType
  quantity      Decimal      @db.Decimal(12, 2)
  unitCost      Decimal      @db.Decimal(12, 2)
  previousStock Decimal      @db.Decimal(12, 2)
  newStock      Decimal      @db.Decimal(12, 2)
  referenceId   String?      // e.g. saleId or purchaseId
  actorId       String

  createdAt DateTime @default(now())

  @@index([productId])
}

model Purchase {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id])
  actorId        String

  totalAmount    Decimal      @db.Decimal(12, 2)
  invoiceNumber  String?

  createdAt DateTime @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])

  quantity   Decimal  @db.Decimal(12, 2)
  unitCost   Decimal  @db.Decimal(12, 2)
  subtotal   Decimal  @db.Decimal(12, 2)
}

model Customer {
  id                    String              @id @default(uuid())
  institutionalPersonId String              @unique
  institutionalPerson   InstitutionalPerson @relation(fields: [institutionalPersonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  sales Sale[]
}

model Sale {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id])
  actorId        String

  totalAmount    Decimal      @db.Decimal(12, 2)
  totalCost      Decimal      @db.Decimal(12, 2) // COGS total sum(quantity * WAC)
  grossProfit    Decimal      @db.Decimal(12, 2) // totalAmount - totalCost

  createdAt DateTime @default(now())

  items SaleItem[]
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Decimal @db.Decimal(12, 2)
  unitPrice Decimal @db.Decimal(12, 2)
  unitCost  Decimal @db.Decimal(12, 2) // WAC al momento de la venta
  subtotal  Decimal @db.Decimal(12, 2)
}

// ------------------------------------------------------
// 4. AUDIT DOMAIN
// ------------------------------------------------------

model AuditLog {
  id             String        @id @default(uuid())
  actorId        String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  action         String        // e.g. "CREATE_PRODUCT", "REGISTER_SALE", "UPDATE_ROLE"
  entity         String        // e.g. "Product", "Sale", "Membership"
  entityId       String
  previousState  Json?
  newState       Json?
  ipAddress      String?
  userAgent      String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
}
