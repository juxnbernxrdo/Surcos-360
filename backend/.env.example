# ==============================================================================
# SURCOS 360 - BACKEND ENVIRONMENT CONFIGURATION (NESTJS / PRISMA)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Database (PostgreSQL with RLS & Connection Pooling)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/surcos360_dev?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/surcos360_dev?schema=public"

# Supabase Auth & JWT Verification (§3 PRD v1.0)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret"

# Institution Tenant Defaults
DEFAULT_INSTITUTION_ID="inst-surcos-main"
DEFAULT_INSTITUTION_DOMAIN="@colegiosurcos.edu.ec"

# Throttling & Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
